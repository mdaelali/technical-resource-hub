# Copy this to .env.local and fill in your project credentials.

# Supabase — required for auth and data sync. Publishable keys are safe in a
# browser when Row Level Security is configured; never use a secret/service key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy compatibility only; prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Online Compiler uses the public, rate-limited Judge0 CE endpoint.
# Do not add a personal API key here: VITE_ values are public in the browser.
