# Copy this to .env.local and fill in your project credentials.

# Supabase — required for auth and data sync
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Judge0 — optional, for the Online Compiler.
# Defaults to https://ce.judge0.com when these are not set.
# For reliability, sign up at rapidapi.com (free tier) and use:
#   VITE_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
#   VITE_JUDGE0_HOST=judge0-ce.p.rapidapi.com
#   VITE_JUDGE0_KEY=<your RapidAPI key>
